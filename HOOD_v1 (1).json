        "messages": {
          "values": [
            {
              "content": "=You are a senior B2B consultant evaluating local businesses for web overhaul, CRM/booking automation, and AI concierge opportunities.\n\nData:\n{{ $json.batch_json }}\n\nTASK:\nEvaluate EVERY business present in the JSON array above. Return a clean, valid JSON array containing one object for each evaluated business with its matching business_id.\n\nOUTPUT FORMAT (JSON array only, no markdown code blocks):\n[\n  {\n    \"business_id\": 52,\n    \"fit_score\": 8,\n    \"opportunity_type\": \"Automation/Chatbot\",\n    \"pitch\": \"2-sentence specific gap observation based on snippet.\",\n    \"action\": \"Outreach\"\n  }\n]"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        3584,
        304
      ],
