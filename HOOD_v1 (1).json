          "id": "dPK5hMkpaRTJqjde",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => ({\n  business_id: i.json.business_id,\n  name: i.json.business_name,\n  domain: i.json.canonical_domain,\n  phone: i.json.phone,\n  email: i.json.public_email,\n  title: i.json.page_title,\n  snippet: i.json.website_content\n}));\n\nreturn [{\n  json: {\n    batch_json: JSON.stringify(items),\n    count: items.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3232,
        352
      ],
      "id": "534635eb-f53f-472e-b247-1088845f2300",
      "name": "Pack 50 items"
    },
    {
      "parameters": {
        "jsCode": "// 1. Extract raw response text from Gemini\nconst rawText = $input.first().json.content?.parts?.[0]?.text || $input.first().json.text || \"[]\";\n\n// 2. Clean out any potential markdown code blocks\nconst cleaned = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n\nlet evaluations = [];\ntry {\n  evaluations = JSON.parse(cleaned);\n  // Ensure we are working with an array\n  if (!Array.isArray(evaluations)) {\n    evaluations = [evaluations];\n  }\n} catch (e) {\n  evaluations = [];\n}\n\n// 3. Get the original prospect records from the current batch loop\nconst originalBatch = $('Loop Over Items').all();\n\n// 4. Match evaluation data back to the full database prospect rows\nreturn evaluations.map(evalItem => {\n  const original = originalBatch.find(item => item.json.business_id === evalItem.business_id)?.json || {};\n  \n  return {\n    json: {\n      business_id: evalItem.business_id || original.business_id,\n      business_name: original.business_name || \"N/A\",\n      canonical_domain: original.canonical_domain || \"N/A\",\n      phone: original.phone || \"N/A\",\n      public_email: original.public_email || \"N/A\",\n      industry: original.industry || \"N/A\",\n      locations: original.locations || \"N/A\",\n      page_title: original.page_title || \"N/A\",\n      fit_score: Number(evalItem.fit_score) || 0,\n      opportunity_type: evalItem.opportunity_type || \"None\",\n      pitch: evalItem.pitch || \"N/A\",\n      action: evalItem.action || \"Skip\",\n      run_id: original.run_id || \"N/A\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
